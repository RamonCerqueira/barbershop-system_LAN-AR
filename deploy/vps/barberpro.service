[Unit]
Description=BarberPro application
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=barberpro
Group=barberpro
WorkingDirectory=/opt/barberpro/current
EnvironmentFile=/opt/barberpro/shared/app.env
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3214
ExecStartPre=/opt/barberpro/runtime/bin/node /opt/barberpro/current/scripts/check-env.cjs
ExecStart=/opt/barberpro/runtime/bin/node /opt/barberpro/current/node_modules/next/dist/bin/next start --hostname 127.0.0.1 --port 3214
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
MemoryMax=512M
CPUQuota=75%
TasksMax=128
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/barberpro/shared /opt/barberpro/current/.next/cache
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
