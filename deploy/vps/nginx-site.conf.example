# Template only. Replace DOMAIN after DNS/ownership verification.
# Never add the shared server IP to server_name.
server {
    listen 80;
    listen [::]:80;
    server_name DOMAIN;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:3214;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }
}
# HTTPS certificate and HTTP redirect must be added for this site alone before
# public access. APP_URL must be the exact final HTTPS origin.
