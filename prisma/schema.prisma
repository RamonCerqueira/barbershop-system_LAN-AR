// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo para o proprietário do sistema (super admin)
model SystemOwner {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_owners")
}

// Modelo para as empresas (barbearias)
model Company {
  id                    String             @id @default(cuid())
  name                  String
  email                 String             @unique
  cpf                   String             @unique
  fullName              String
  birthDate             DateTime
  address               String
  phone                 String
  waitingRoomEnabled    Boolean            @default(false)
  waitingRoomToken      String?            @unique
  waitingRoomCalledId   String?
  waitingRoomCalledAt   DateTime?
  logoPath              String?
  plan                  Plan               @default(MONTHLY)
  planPrice             Decimal            @db.Decimal(12, 2)
  isActive              Boolean            @default(true)
  subscriptionStatus    SubscriptionStatus @default(TRIAL)
  trialStartedAt        DateTime           @default(now())
  trialEndsAt           DateTime?
  subscriptionStartedAt DateTime?
  currentPeriodEnd      DateTime?
  pendingPlanPrice      Decimal?           @db.Decimal(12, 2)
  pendingPlan           Plan?
  pendingPlanStartsAt   DateTime?
  lastPaymentAt         DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  contractAcceptances         ContractAcceptance[]
  // Relacionamentos
  customerFavorites           CustomerFavorite[]
  customerReviews             CustomerReview[]
  photos                      CompanyPhoto[]
  users                       User[]
  services                    Service[]
  employees                   Employee[]
  products                    Product[]
  clients                     Client[]
  appointments                Appointment[]
  sales                       Sale[]
  whatsappCampaigns           WhatsAppCampaign[]
  settings                    CompanySettings?
  notifications               Notification[]
  subscriptionPayments        SubscriptionPayment[]
  subscriptionNotificationLogs SubscriptionNotificationLog[]
  employeeBlocks              EmployeeBlock[]
  waitlist                    WaitlistEntry[]

  @@index([subscriptionStatus, trialEndsAt], map: "companies_sub_trial_idx")
  @@index([subscriptionStatus, currentPeriodEnd], map: "companies_sub_period_idx")
  @@map("companies")
}

enum Plan {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  PRO_MONTHLY
  PRO_SEMIANNUAL
  PRO_ANNUAL
  ELITE_MONTHLY
  ELITE_SEMIANNUAL
  ELITE_ANNUAL
  ANNUAL
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PENDING_PAYMENT
  PAST_DUE
  SUSPENDED
  BLOCKED
}

enum SubscriptionPaymentStatus {
  PENDING
  APPROVED
  REJECTED
}

// Modelo para usuários do sistema (administradores das barbearias)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  avatarPath String?
  role      UserRole @default(ADMIN)
  companyId String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relacionamentos
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  passwordReset PasswordReset?

  @@map("users")
}

enum UserRole {
  ADMIN
  MANAGER
  EMPLOYEE
}

// Modelo para serviços
model Service {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("Cabelo")
  price       Decimal @db.Decimal(12, 2)
  duration    Int      // em minutos
  isActive    Boolean  @default(true)
  companyId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  serviceCosts ServiceCost[]

  @@map("services")
}

// Modelo para controle de custos dos serviços
model ServiceCost {
  id          String   @id @default(cuid())
  serviceId   String
  itemName    String   // Ex: "Tinta", "Shampoo", "Condicionador", "Escova"
  costPerUse  Decimal @db.Decimal(12, 2)    // Custo por uso/aplicação
  unit        String   // Ex: "ml", "g", "unidade"
  supplier    String?  // Fornecedor
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relacionamentos
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_costs")
}

// Modelo para campanhas de recorrência WhatsApp
model WhatsAppCampaign {
  id          String    @id @default(cuid())
  name        String
  message     String
  triggerDays Int       // Dias após último agendamento para enviar
  lastSent    DateTime?
  isActive    Boolean   @default(true)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relacionamentos
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignLogs WhatsAppCampaignLog[]

  @@map("whatsapp_campaigns")
}

// Modelo para log de campanhas enviadas
model WhatsAppCampaignLog {
  id           String           @id @default(cuid())
  campaignId   String
  clientId     String
  sentAt       DateTime         @default(now())
  status       CampaignStatus   @default(SENT)
  response     String?          // Resposta do cliente, se houver
  errorMessage String?

  // Relacionamentos
  campaign WhatsAppCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  client   Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("whatsapp_campaign_logs")
}

enum CampaignStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  REPLIED
  FAILED
}

// Modelo para colaboradores
model Employee {
  id             String       @id @default(cuid())
  name           String
  email          String?
  phone          String
  role           EmployeeRole
  customRole     String?      // Para roles personalizados
  salary         Decimal @db.Decimal(12, 2)        @default(0)
  commissionRate Decimal @db.Decimal(12, 2)        @default(0)
  hireDate       DateTime
  isActive       Boolean      @default(true)
  companyId      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relacionamentos
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  specialties  EmployeeSpecialty[]
  blocks       EmployeeBlock[]

  @@map("employees")
}

model PasswordReset {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String   @unique
  code      String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_resets")
}

// Modelo para especialidades dos colaboradores
model EmployeeSpecialty {
  id         String         @id @default(cuid())
  employeeId String
  specialty  String         // Ex: "Tintura", "Corte", "Corte Livre", "Barba", "Sobrancelha"
  level      SpecialtyLevel @default(INTERMEDIATE)
  isActive   Boolean        @default(true)
  createdAt  DateTime       @default(now())

  // Relacionamentos
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, specialty])
  @@map("employee_specialties")
}

enum SpecialtyLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum EmployeeRole {
  BARBER
  ADMIN
  MARKETING
  GENERAL_SERVICES
  PODIATRY
  MASSAGE
  OTHER
}

// Modelo para produtos
model Product {
  id          String          @id @default(cuid())
  name        String
  description String?
  category    ProductCategory
  price       Decimal @db.Decimal(12, 2)
  stock       Int
  minStock    Int
  isActive    Boolean         @default(true)
  companyId   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  // Relacionamentos
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleItems SaleItem[]

  @@map("products")
}

enum ProductCategory {
  BEVERAGES
  SNACKS
  GAMES
  OTHER
}

// Modelo para clientes
model Client {
  requireDeposit Boolean @default(false)
  customerAccountId String?
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  id          String    @id @default(cuid())
  fullName    String
  phone       String
  email       String?
  address     String?
  birthDate   DateTime?
  notes       String?
  totalVisits Int       @default(0)
  totalSpent  Decimal @db.Decimal(12, 2)     @default(0)
  rating      Float?    @default(5)
  isActive    Boolean   @default(true)
  whatsappConsent Boolean @default(false)
  companyId   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relacionamentos
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  sales        Sale[]
  campaignLogs WhatsAppCampaignLog[]

  @@index([customerAccountId, companyId])
  @@index([companyId, phone], map: "clients_company_phone_idx")
  @@map("clients")
}

// Modelo para agendamentos
model Appointment {
  depositRequired Boolean @default(false)
  depositAmount Decimal @db.Decimal(12, 2) @default(0)
  photos AppointmentPhoto[]
  customerAccountId String?
  customerAccount CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)
  review CustomerReview?
  id         String            @id @default(cuid())
  date       DateTime
  time       String
  status     AppointmentStatus @default(SCHEDULED)
  notes      String?
  price      Decimal @db.Decimal(12, 2)
  clientId   String
  serviceId  String
  employeeId String
  companyId  String
  confirmationHash String? @unique
  confirmationExpiresAt DateTime?
  duration Int @default(30)
  idempotencyKey String? @unique
  serviceNameSnapshot String @default("")
  employeeNameSnapshot String @default("")
  costSnapshot Decimal @db.Decimal(12, 2) @default(0)
  commissionSnapshot Decimal @db.Decimal(12, 2) @default(0)
  snapshotEstimated Boolean @default(false)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  // Relacionamentos
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  service  Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales    Sale[]

  @@index([customerAccountId, date])
  @@index([companyId, employeeId, date], map: "appointments_company_employee_date_idx")
  @@map("appointments")
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

// Modelo para vendas
model Sale {
  id            String            @id @default(cuid())
  type          SaleType
  description   String
  amount        Decimal @db.Decimal(12, 2)
  paymentMethod PaymentMethod
  status        SalePaymentStatus @default(COMPLETED)
  proofUrl      String?
  appointmentId String?
  clientId      String?
  companyId     String
  idempotencyKey String? @unique
  stockDebited Boolean @default(false)
  refundedAt DateTime?
  refundReason String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  // Relacionamentos
  client      Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  saleItems   SaleItem[]

  @@index([companyId, createdAt], map: "sales_company_createdAt_idx")
  @@map("sales")
}

enum SaleType {
  SERVICE
  PRODUCT
}

enum PaymentMethod {
  CASH
  PIX
  DEBIT_CARD
  CREDIT_CARD
}

enum SalePaymentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  REFUNDED
}

// Modelo para itens de venda (produtos)
model SaleItem {
  id         String   @id @default(cuid())
  quantity   Int
  unitPrice  Decimal @db.Decimal(12, 2)
  totalPrice Decimal @db.Decimal(12, 2)
  saleId     String
  productId  String
  createdAt  DateTime @default(now())

  // Relacionamentos
  sale    Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("sale_items")
}

// Modelo para configurações da empresa
model CompanySettings {
  id                 String   @id @default(cuid())
  companyId          String   @unique
  businessHours      Json     // Horários de funcionamento
  appointmentConfig  Json     // Configurações de agendamento
  whatsappConfig     Json?    // Configurações do WhatsApp
  locationConfig     Json?    // Configurações de localização
  notificationConfig Json?    // Configurações de notificações
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  // Relacionamentos
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// Modelo para notificações
model Notification {
  id        String           @id @default(cuid())
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  userId    String?
  companyId String?
  createdAt DateTime         @default(now())

  // Relacionamentos
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum NotificationType {
  APPOINTMENT
  PAYMENT
  SYSTEM
  MARKETING
}

model AuthSession {
  id String @id @default(cuid())
  subjectId String
  subjectType String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([subjectId, subjectType])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model RateLimitBucket {
  id String @id
  count Int @default(1)
  expiresAt DateTime
  @@index([expiresAt])
  @@map("rate_limit_buckets")
}

model RecoveryToken {
  id String @id @default(cuid())
  subjectId String
  subjectType String
  tokenHash String @unique
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())
  @@index([subjectId, subjectType])
  @@index([expiresAt])
  @@map("recovery_tokens")
}

model AuditLog {
  id String @id @default(cuid())
  companyId String?
  actorId String
  action String
  entityId String
  createdAt DateTime @default(now())
  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model StockMovement {
  id String @id @default(cuid())
  companyId String
  productId String
  saleId String
  quantity Int
  reason String
  createdAt DateTime @default(now())
  @@index([companyId, productId, createdAt])
  @@map("stock_movements")
}

model OutboundMessage {
  appointmentId String?
  appointmentVersion String?
  customerAlertId String?
  purpose String @default("TENANT")
  instanceName String?
  acceptedAt DateTime?
  quotaMonth String?
  id String @id @default(cuid())
  companyId String
  clientId String?
  campaignId String?
  to String
  message String
  status String @default("QUEUED")
  dedupKey String @unique
  providerId String? @unique
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  @@index([companyId, quotaMonth, status])
  @@index([status, nextAttemptAt])
  @@map("outbound_messages")
}

model SubscriptionPayment {
  id              String                    @id @default(cuid())
  companyId       String
  plan            Plan
  baseAmount      Decimal?                  @db.Decimal(12, 2)
  discountPercent Int                       @default(0)
  amount          Decimal                   @db.Decimal(12, 2)
  status          SubscriptionPaymentStatus @default(PENDING)
  paymentMethod   String                    @default("PIX")
  pixKey          String
  pixBeneficiary  String
  pixBank         String
  payerNote       String?
  proofFilePath   String?
  proofFileName   String?
  proofMimeType   String?
  submittedAt     DateTime                  @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  reviewedByName  String?
  rejectionReason String?
  periodStart     DateTime?
  periodEnd       DateTime?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  contractAcceptance ContractAcceptance?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status], map: "sub_payments_company_status_idx")
  @@index([status, createdAt], map: "sub_payments_status_created_idx")
  @@map("subscription_payments")
}

model SubscriptionNotificationLog {
  id                    String   @id @default(cuid())
  companyId             String
  subscriptionPaymentId String?
  type                  String
  referenceDate         String
  channel               String
  status                String   @default("SENT")
  recipient             String
  message               String
  dedupKey              String   @unique
  errorMessage          String?
  sentAt                DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sentAt], map: "sub_notif_company_sent_idx")
  @@index([type, referenceDate], map: "sub_notif_type_ref_idx")
  @@map("subscription_notification_logs")
}

model EmployeeBlock {
  id         String   @id @default(cuid())
  companyId  String
  employeeId String
  date       String
  startTime  String
  endTime    String
  reason     String?
  createdAt  DateTime @default(now())

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, date], map: "employee_blocks_comp_emp_date_idx")
  @@map("employee_blocks")
}

model CustomerAccount {
  reminderEmail Boolean @default(false)
  reminderWhatsapp Boolean @default(false)
  alerts CustomerAlert[]
  waitlist WaitlistEntry[]
  id String @id @default(cuid())
  name String
  email String @unique
  phone String
  password String
  avatarPath String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions CustomerSession[]
  resets CustomerPasswordReset[]
  clients Client[]
  appointments Appointment[]
  favorites CustomerFavorite[]
  reviews CustomerReview[]
  @@map("customer_accounts")
}
model CustomerSession {
  id String @id @default(cuid())
  tokenHash String @unique
  customerId String
  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([customerId])
  @@map("customer_sessions")
}
model CustomerPasswordReset {
  id String @id @default(cuid())
  tokenHash String @unique
  customerId String
  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt DateTime?
  @@map("customer_password_resets")
}
model CustomerFavorite {
  customerId String
  companyId String
  createdAt DateTime @default(now())
  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@id([customerId, companyId])
  @@map("customer_favorites")
}
model CustomerReview {
  id String @id @default(cuid())
  customerId String
  companyId String
  appointmentId String @unique
  rating Int
  comment String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  @@index([companyId, createdAt])
  @@map("customer_reviews")
}
model CompanyPhoto {
  id String @id @default(cuid())
  companyId String
  filename String
  createdAt DateTime @default(now())
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@index([companyId])
  @@map("company_photos")
}

model CustomerAlert {
  appointmentVersion String?
  id String @id @default(cuid())
  customerId String
  companyId String
  appointmentId String?
  title String
  message String
  href String @default("/cliente/agendamentos")
  dedupKey String @unique
  readAt DateTime?
  createdAt DateTime @default(now())
  emailStatus String @default("PENDING")
  whatsappStatus String @default("PENDING")
  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  @@index([customerId, createdAt])
  @@index([emailStatus, createdAt])
  @@map("customer_alerts")
}

model WaitlistEntry {
  id String @id @default(cuid())
  customerId String
  companyId String
  serviceId String
  employeeId String
  date String
  time String
  status String @default("WAITING")
  offeredAt DateTime?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  customer CustomerAccount @relation(fields: [customerId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  @@unique([customerId, companyId, serviceId, employeeId, date, time])
  @@index([status, date, createdAt])
  @@index([companyId, employeeId, date, time, status])
  @@map("waitlist_entries")
}

model AppointmentPhoto {
  id String @id @default(cuid())
  appointmentId String
  filename String
  publicationConsent Boolean @default(false)
  consentAt DateTime?
  createdAt DateTime @default(now())
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  @@index([appointmentId])
  @@map("appointment_photos")
}

model WhatsAppConnection {
  companyId String @id
  instanceName String @unique
  generation Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("whatsapp_connections")
}

model ContractAcceptance {
  id String @id @default(cuid())
  companyId String
  actorId String
  actorName String
  actorEmail String
  kind String
  version String
  privacyVersion String
  documentHash String
  content String @db.Text
  plan Plan
  amount Decimal @db.Decimal(12, 2)
  acceptedAt DateTime @default(now())
  paymentId String? @unique
  company Company @relation(fields:[companyId], references:[id], onDelete:Restrict)
  payment SubscriptionPayment? @relation(fields:[paymentId], references:[id], onDelete:Restrict)
  @@index([companyId, acceptedAt])
  @@map("contract_acceptances")
}
